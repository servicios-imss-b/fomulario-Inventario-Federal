# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DJANGO & BACKEND SETTINGS
DJANGO_SECRET_KEY="django-insecure-cambiar-en-produccion-inegi-ifpads-2025"
DEBUG=False
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"
API_URL="http://localhost:3000/api"
PORT=3010

# Supabase browser configuration. The anon key is public; restrict access with RLS/RPC.
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-public-key"

# GESTIÓN DE ARCHIVOS Y CARGA
MAX_UPLOAD_SIZE_MB=15
MAX_OPEN_QUESTION_CHARS=300

# Google Drive uploads use the existing account's storage quota; no paid storage service.
# Run this app on port 3010, then authorize it at http://localhost:3010/api/drive/auth.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3010/api/drive/oauth/callback"
GOOGLE_DRIVE_FOLDER_ID="1VxUTlq70YT5dqpD3HmM5IOmb69_Y6Mj9"

